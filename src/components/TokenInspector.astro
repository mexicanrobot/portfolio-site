---
/*
 * Live Design Token Readout — turns Alejandro's design-systems specialty
 * into a tactile interactive hardware module right on the page.
 */
---

<section class="token-deck panel" aria-label="Live Design Token Inspector">
	<div class="token-deck__head">
		<div>
			<div class="section-kicker">
				<span class="led" aria-hidden="true"></span>
				<span class="mono-label">LIVE SYSTEM // DESIGN TOKENS</span>
			</div>
			<h2 class="token-deck__title">Built on live semantic tokens.</h2>
			<p class="token-deck__subtitle">
				Switch chassis finishes to inspect the active CSS custom properties driving this site in real time.
			</p>
		</div>

		<div class="token-deck__switches" role="group" aria-label="Select chassis finish">
			<button type="button" class="chassis-key" data-set-theme="silver">
				<span class="chassis-key__swatch" style="background: linear-gradient(135deg, #f3f4f7 50%, #2b44e7 50%);"></span>
				<span>VAIO SILVER</span>
			</button>
			<button type="button" class="chassis-key" data-set-theme="obsidian">
				<span class="chassis-key__swatch" style="background: linear-gradient(135deg, #161920 50%, #6c8bff 50%);"></span>
				<span>MD OBSIDIAN</span>
			</button>
			<button type="button" class="chassis-key" data-set-theme="cyber">
				<span class="chassis-key__swatch" style="background: linear-gradient(135deg, #f2eee5 50%, #d94612 50%);"></span>
				<span>WM STONE</span>
			</button>
		</div>
	</div>

	<div class="token-lcd" id="token-lcd">
		<div class="token-chip" data-token="--bg">
			<span class="token-chip__dot" style="background: var(--bg);"></span>
			<span class="token-chip__name">--bg</span>
			<span class="token-chip__val" data-token-val="--bg">#e7e9ee</span>
		</div>
		<div class="token-chip" data-token="--surface">
			<span class="token-chip__dot" style="background: var(--surface);"></span>
			<span class="token-chip__name">--surface</span>
			<span class="token-chip__val" data-token-val="--surface">#f3f4f7</span>
		</div>
		<div class="token-chip" data-token="--ink">
			<span class="token-chip__dot" style="background: var(--ink);"></span>
			<span class="token-chip__name">--ink</span>
			<span class="token-chip__val" data-token-val="--ink">#121418</span>
		</div>
		<div class="token-chip" data-token="--accent">
			<span class="token-chip__dot" style="background: var(--accent);"></span>
			<span class="token-chip__name">--accent</span>
			<span class="token-chip__val" data-token-val="--accent">#2b44e7</span>
		</div>
		<div class="token-chip" data-token="--led">
			<span class="token-chip__dot" style="background: var(--led);"></span>
			<span class="token-chip__name">--led</span>
			<span class="token-chip__val" data-token-val="--led">#ff4f17</span>
		</div>
	</div>
</section>

<script is:inline>
	(() => {
		const updateTokens = () => {
			const styles = getComputedStyle(document.documentElement);
			document.querySelectorAll('[data-token-val]').forEach((el) => {
				const token = el.getAttribute('data-token-val');
				if (!token) return;
				const value = styles.getPropertyValue(token).trim();
				if (value) el.textContent = value;
			});
		};
		updateTokens();
		window.addEventListener('aa:theme-change', () => requestAnimationFrame(updateTokens));
	})();
</script>

<style>
	.token-deck {
		padding: 1.75rem;
		margin-top: 3.5rem;
	}

	.token-deck__head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
		margin-bottom: 1.4rem;
	}

	.token-deck__title {
		font-size: clamp(1.3rem, 2.2vw, 1.65rem);
		margin-bottom: 0.35rem;
	}

	.token-deck__subtitle {
		margin: 0;
		font-size: 0.94rem;
		max-width: 52ch;
	}

	.token-deck__switches {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.chassis-key {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		padding: 0.5rem 0.85rem;
		border-radius: 8px;
		border: 1px solid var(--border);
		background: var(--surface-elevated);
		color: var(--ink-muted);
		box-shadow: var(--shadow-bevel);
		cursor: pointer;
		transition: all 0.16s var(--ease-tactile);
	}

	.chassis-key:hover {
		color: var(--ink);
		border-color: var(--accent);
	}

	.chassis-key.is-active {
		color: var(--ink);
		border-color: var(--accent);
		box-shadow:
			var(--shadow-bevel),
			0 0 0 2px var(--accent-soft);
	}

	.chassis-key__swatch {
		width: 14px;
		height: 14px;
		border-radius: 4px;
		border: 1px solid var(--border-strong);
	}

	.token-lcd {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0.75rem;
		padding: 0.9rem;
		border-radius: var(--radius-md);
		background: var(--lcd-bg);
		border: 1px solid var(--border-strong);
		box-shadow: var(--shadow-recessed);
	}

	.token-chip {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 0.7rem 0.8rem;
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.08);
	}

	.token-chip__dot {
		width: 22px;
		height: 10px;
		border-radius: 3px;
		border: 1px solid rgba(255, 255, 255, 0.25);
	}

	.token-chip__name {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: rgba(255, 255, 255, 0.58);
	}

	.token-chip__val {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--lcd-accent);
	}

	@media (max-width: 820px) {
		.token-lcd {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 520px) {
		.token-deck {
			padding: 1.25rem;
		}
	}
</style>
