---
const today = new Date();
---

<footer class="deck-footer">
	<div class="deck-footer__inner">
		<div class="deck-footer__meta">
			<div class="deck-footer__id">
				<span class="led led--ok" aria-hidden="true"></span>
				<span class="mono-label">ALEJANDRO ABAROA // SAN DIEGO, CA</span>
			</div>
			<p class="deck-footer__copy">
				&copy; {today.getFullYear()} Alejandro Abaroa. Engineered with Astro &amp; live design tokens.
			</p>
		</div>

		<div class="deck-footer__links">
			<a href="/AlexAbaroaCV.pdf" target="_blank" rel="noopener noreferrer" class="footer-key">Resume ↗</a>
			<a href="https://github.com/mexicanrobot/" target="_blank" rel="noopener noreferrer" class="footer-key">GitHub</a>
			<a href="https://www.linkedin.com/in/alejandro-abaroa/" target="_blank" rel="noopener noreferrer" class="footer-key">LinkedIn</a>
			<a href="https://dribbble.com/alejandroabaroa" target="_blank" rel="noopener noreferrer" class="footer-key">Dribbble</a>
		</div>
	</div>
</footer>

<style>
	.deck-footer {
		border-top: 1px solid var(--border);
		background: var(--surface);
		box-shadow: inset 0 1px 0 var(--highlight);
	}

	.deck-footer__inner {
		max-width: var(--container);
		margin: 0 auto;
		padding: 1.75rem 1.5rem 2.25rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.deck-footer__id {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.35rem;
	}

	.deck-footer__copy {
		margin: 0;
		font-size: 0.85rem;
		color: var(--ink-subtle);
	}

	.deck-footer__links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.footer-key {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		font-weight: 500;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--ink-muted);
		padding: 0.42rem 0.75rem;
		border-radius: 6px;
		background: var(--surface-elevated);
		border: 1px solid var(--border);
		box-shadow: var(--shadow-bevel);
	}

	.footer-key:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
</style>
